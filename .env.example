DATABASE_URL=postgresql+asyncpg://livepulse:livepulse@localhost:5432/livepulse
LIVEPULSE_MODE=PERSONAL_LOCAL
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=livepulse.events.football.v1
KAFKA_CONSUMER_GROUP=livepulse-projector-v1
DEMO_STEP_SECONDS=6
RETENTION_DAYS=365

# PUBLIC_DEMO requires a dedicated database and explicit exact allowlists.
# Use docker-compose.public-demo.yml for its isolated database/broker stack.
# Never set these to the PERSONAL_LOCAL database/credentials.
PUBLIC_DEMO_DATABASE_URL=
PUBLIC_DEMO_DB_PASSWORD=
PUBLIC_DEMO_ALLOWED_HOSTS=["localhost","127.0.0.1"]
PUBLIC_DEMO_ALLOWED_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]

# Optional provider configuration. Blank credentials disable only that provider.
# API-Football v3. Leave blank to keep the real football provider disconnected.
API_FOOTBALL_KEY=

# Spotify OAuth (tokens will be encrypted at rest with CREDENTIAL_ENCRYPTION_KEY).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# GitHub reconciliation and signed webhook verification.
GITHUB_OWNER=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Google OAuth for the read-only Gmail provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Open-Meteo has no API key. Supply personal coordinates only in the ignored .env.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEZONE=

# Generate locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only when persisting OAuth credentials; never commit the generated value.
CREDENTIAL_ENCRYPTION_KEY=
