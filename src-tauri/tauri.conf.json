{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LivePulse",
  "version": "0.1.0",
  "identifier": "com.livepulse.desktop",
  "build": {
    "beforeDevCommand": "npm run tauri:dev-server",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LivePulse",
        "width": 1600,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 700,
        "maximized": true,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:8000 ws://127.0.0.1:8000 http://127.0.0.1:5174 ws://127.0.0.1:5174"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
